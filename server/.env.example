# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/momentra

# JWT RS256 key pair (base64-encoded PEM).
# Generate a fresh pair with:
#   openssl genrsa -out priv.pem 2048
#   openssl rsa -in priv.pem -pubout -out pub.pem
#   base64 -w0 priv.pem  # paste below
#   base64 -w0 pub.pem   # paste below
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
BCRYPT_COST=12

# Optional — S3 mode (leave blank to use local filesystem)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
