# ─── Database (required) ──────────────────────────────────────────────────────
# Get a free Postgres DB from https://neon.tech or https://supabase.com
# Or use local: postgresql://postgres:yourpassword@localhost:5432/momentra
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/momentra

# ─── JWT RS256 Keys (required) ────────────────────────────────────────────────
# Generate once with:
#   openssl genrsa -out priv.pem 2048
#   openssl rsa -in priv.pem -pubout -out pub.pem
# Then paste the base64-encoded values below:
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("priv.pem"))
#   Mac/Linux:          base64 -w0 priv.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
BCRYPT_COST=12

# ─── Cloudinary (optional — only needed for production) ───────────────────────
# In development, files are stored locally in ./uploads/
# In production set these three vars and local disk is bypassed automatically:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
